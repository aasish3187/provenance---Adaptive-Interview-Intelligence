# ==========================================
# Provenance Environment Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=info

# API Service
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Service
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://provenance:provenance_dev@localhost:5432/provenance
DATABASE_URL_TEST=sqlite:///./test.db

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# Gemini API (Server-Side Only - Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Ephemeral Token Expiration (seconds)
EPHEMERAL_TOKEN_TTL_SECONDS=3600

# Secret Key for JWT / Auth & Invites
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
